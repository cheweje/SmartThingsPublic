# =============================================================================
# RSAF Monitor — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — it contains secrets.
# =============================================================================

# --- Required: Anthropic API Key ---
# Get yours at: https://console.anthropic.com/
RSAF_ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Required: Email Settings ---
# For Gmail: use an "App Password" (not your regular password).
# How to create one: https://support.google.com/accounts/answer/185833
RSAF_SMTP_HOST=smtp.gmail.com
RSAF_SMTP_PORT=587
RSAF_SMTP_USERNAME=your-email@gmail.com
RSAF_SMTP_PASSWORD=your-app-password-here
RSAF_SENDER_EMAIL=your-email@gmail.com
RSAF_RECIPIENT_EMAIL=recipient@example.com

# --- Optional: Search Provider ---
# Default is "duckduckgo" (free, no key needed).
# For better results, use "serpapi" or "google_cse".
RSAF_SEARCH_PROVIDER=duckduckgo

# Uncomment if using SerpAPI:
# RSAF_SERPAPI_KEY=your-serpapi-key

# Uncomment if using Google Custom Search:
# RSAF_GOOGLE_CSE_API_KEY=your-google-api-key
# RSAF_GOOGLE_CSE_CX=your-custom-search-engine-id

# --- Optional: LLM Model ---
# RSAF_LLM_MODEL=claude-sonnet-4-20250514

# --- Optional: Run Modes ---
# RSAF_DRY_RUN=false
# RSAF_TEST_MODE=false
# RSAF_LOG_LEVEL=INFO
